# MedLens Environment Configuration

# ----------------------------------------------------------------------
# 1. GOOGLE GEMINI API KEY (RECOMMENDED & 100% FREE)
# Get your free key instantly at: https://aistudio.google.com/
# No credit card required. Free tier offers 15 requests/min and 1,500/day.
# ----------------------------------------------------------------------
GEMINI_API_KEY=

# Gemini model to use (default: gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ----------------------------------------------------------------------
# 2. ALTERNATIVE: ANTHROPIC CLAUDE API KEY (Optional)
# Get a key at https://console.anthropic.com/
# ----------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ----------------------------------------------------------------------
# 3. ALTERNATIVE: OPENAI API KEY (Optional)
# Get a key at https://platform.openai.com/
# ----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Port
PORT=3000
